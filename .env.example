# Copy this file to .env and fill in your own values. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Stripe test-mode keys: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Google sign-in (optional): https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail SMTP for account emails (optional). Use an app password, not your real password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
